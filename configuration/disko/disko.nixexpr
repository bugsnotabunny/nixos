{ rootDevice ? throw "Set this to your disk device, e.g. /dev/sda"
, storageDevices ? throw "Unset extra devices list. Use [] if not needed", ...
}: {
  disko.devices = {
    disk = let
      extraDisksList = builtins.map (dev: {
        name = builtins.baseNameOf dev;
        value = {
          type = "disk";
          device = dev;
          content = {
            type = "gpt";
            partitions = {
              zfs = {
                size = "100%";
                content = {
                  type = "zfs";
                  pool = "zroot";
                };
              };
            };
          };
        };
      }) storageDevices;
    in {
      root = {
        type = "disk";
        device = rootDevice;
        content = {
          type = "gpt";
          partitions = {
            ESP = {
              size = "1024M";
              type = "EF00";
              content = {
                type = "filesystem";
                format = "vfat";
                mountpoint = "/boot";
                mountOptions = [ "nofail" ];
              };
            };
            swap = {
              size = "1024M";
              content = {
                type = "swap";
                randomEncryption = true;
              };
            };
            zfs = {
              size = "100%";
              content = {
                type = "zfs";
                pool = "zroot";
              };
            };
          };
        };
      };
    } // builtins.listToAttrs extraDisksList;

    nodev = {
      "/tmp".fsType = "tmpfs";
      "/var/tmp".fsType = "tmpfs";
    };

    zpool = {
      zroot = {
        type = "zpool";

        rootFsOptions = {
          mountpoint = "none";
          compression = "zstd";
          acltype = "posixacl";
          xattr = "sa";
          "com.sun:auto-snapshot" = "true";
        };
        options.ashift = "12";
        datasets = {
          "root/nix" = {
            type = "zfs_fs";
            options.mountpoint = "/nix";
            mountpoint = "/nix";
          };

          "root" = {
            type = "zfs_fs";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
