{
  "disable_ai": true,

  "format_on_save": "on",
  "autosave": "on_focus_change",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",

  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark",
    "dark": "One Dark"
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "tabs": {
    "git_status": true
  },

  "diagnostics": {
    "inline": {
      "enabled": true
    }
  }
}
