{
  "disable_ai": true,

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "format_on_save": "on",
  "autosave": "on_focus_change",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "sticky_scroll" : {
    "enabled": true
  },

  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark",
    "dark": "One Dark"
  },


  "tabs": {
    "git_status": true
  },


  "project_panel": {
    "git_status": true,
    "dock": "right",
    "sort_mode": "directories_first",
    "sticky_scroll": true
  },

  "outline_panel": {
    "dock": "right"
  },

  "git_panel": {
    "dock": "right"
  },

  "diagnostics": {
    "inline": {
      "enabled": true
    }
  }
}
