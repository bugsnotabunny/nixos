{
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "sticky_scroll" : {
    "enabled": true
  },

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Frappé",
  },

  "tabs": {
    "git_status": true
  },

  "project_panel": {
    "git_status": true,
    "dock": "right",
    "sort_mode": "directories_first",
    "sticky_scroll": true
  },

  "collaboration_panel": {
    "dock": "right"
  },

  "outline_panel": {
    "dock": "right"
  },

  "git_panel": {
    "dock": "right"
  },

  "agent": {
    "dock": "right",
  },

  "diagnostics": {
    "inline": {
      "enabled": true
    }
  }
}
